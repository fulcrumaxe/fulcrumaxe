                  "pr_open",
                  "merged",
                  "blocked",
                  "dropped"
                ]
              }
            }
          }
        },
        "roadmap": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "row_key",
              "status",
              "planned_prs"
            ],
            "properties": {
              "row_key": {
                "$ref": "#/$defs/row_key_or_empty"
              },
              "discussion": {
                "$ref": "#/$defs/posint"
              },
