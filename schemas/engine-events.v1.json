          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "items": {
          "type": "array",
          "maxItems": 300,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "discussion",
              "ordinal",
              "state"
            ],
            "properties": {
