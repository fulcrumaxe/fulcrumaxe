        },
        "role": {
          "$ref": "#/$defs/role"
        },
        "verdict": {
          "enum": [
            "pass",
            "fail",
            "done",
            "blocked",
            "needs_fix",
            "unknown"
          ]
        },
        "discussion": {
          "$ref": "#/$defs/posint"
        },
        "pr": {
          "$ref": "#/$defs/posint"
        },
        "duration_s": {
          "$ref": "#/$defs/seconds"
        },
        "model": {
          "$ref": "#/$defs/model_id"
        },
        "credential_mode": {
          "$ref": "#/$defs/credential_mode"
        },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "input",
            "output",
            "cache_read",
            "cache_write"
          ],
          "properties": {
            "input": {
              "$ref": "#/$defs/tokens"
            },
            "output": {
              "$ref": "#/$defs/tokens"
            },
            "cache_read": {
              "$ref": "#/$defs/tokens"
            },
            "cache_write": {
              "$ref": "#/$defs/tokens"
            }
