# autonomous-forever environment variables
# Copy to .env and fill in real values.

# API server port (default: 8080)
AF_API_PORT=8080

# Dashboard port (default: 8420)
AF_DASHBOARD_PORT=8420

# Optional API authentication token (leave blank to disable auth)
# AF_API_TOKEN=

# SQLite state database path (default: .autonomous-team/state.db)
AF_STATE_DB=.autonomous-team/state.db

# Anthropic API key (required for agent spawning)
# ANTHROPIC_API_KEY=
