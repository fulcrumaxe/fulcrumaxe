{
  "name": "load-page",
  "goal": "Verify /project/:id/settings loads at /project/autonomous-forever/settings and reaches its expected 'data' done-state without console errors",
  "url": "http://localhost:5173/project/autonomous-forever/settings",
  "preconditions": {
    "localStorage": {
      "af_dashboard_token": "<test-token>"
    },
    "env": {
      "AF_MCP_TEST_ORIGIN": "1"
    }
  },
  "steps": [
    {
      "action": "navigate_page",
      "url": "http://localhost:5173/project/autonomous-forever/settings",
      "wait_until": "domcontentloaded"
    },
    {
      "action": "wait_for",
      "selector": "h2, [data-testid='backend-badge']",
      "timeout_ms": 15000
    }
  ],
  "success_criteria": [
    {
      "kind": "text_contains",
      "value": "Settings",
      "description": "Page heading must render"
    },
    {
      "kind": "element_exists",
      "selector": "[data-testid='backend-badge']",
      "description": "Content marker 'backend-badge' must render"
    },
    {
      "kind": "no_console_errors",
      "description": "No uncaught JavaScript errors on load"
    }
  ],
  "must_not_happen": [
    {
      "kind": "network_request",
      "url_matches": "/api/loop/run",
      "description": "Page load must not trigger a loop run"
    }
  ],
  "visual_verification": {
    "routes_touched": [
      "/project/:id/settings"
    ],
    "assertions": [
      "Route /project/:id/settings renders its 'data' done-state",
      "data-testid='backend-badge' present"
    ],
    "negative_checks": [
      "No uncaught console errors",
      "No loop run triggered on page load"
    ]
  },
  "covers_discussion": "1536"
}
