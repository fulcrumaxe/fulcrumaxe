{
  "name": "load-page",
  "goal": "Verify /pr/:number loads at /pr/1 and reaches its expected 'data' done-state without console errors",
  "url": "http://localhost:5173/pr/1",
  "preconditions": {
    "localStorage": {
      "af_dashboard_token": "<test-token>"
    },
    "env": {
      "AF_MCP_TEST_ORIGIN": "1"
    }
  },
  "steps": [
    {
      "action": "navigate_page",
      "url": "http://localhost:5173/pr/1",
      "wait_until": "domcontentloaded"
    },
    {
      "action": "wait_for",
      "selector": "[data-testid='pr-detail-page']",
      "timeout_ms": 15000
    }
  ],
  "success_criteria": [
    {
      "kind": "element_exists",
      "selector": "[data-testid='pr-detail-page']",
      "description": "Content marker 'pr-detail-page' must render"
    },
    {
      "kind": "no_console_errors",
      "description": "No uncaught JavaScript errors on load"
    }
  ],
  "must_not_happen": [
    {
      "kind": "network_request",
      "url_matches": "/api/loop/run",
      "description": "Page load must not trigger a loop run"
    }
  ],
  "visual_verification": {
    "routes_touched": [
      "/pr/:number"
    ],
    "assertions": [
      "Route /pr/:number renders its 'data' done-state",
      "data-testid='pr-detail-page' present"
    ],
    "negative_checks": [
      "No uncaught console errors",
      "No loop run triggered on page load"
    ]
  },
  "covers_discussion": "1536"
}
